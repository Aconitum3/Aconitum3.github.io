---
import BaseLayout from '@/layouts/BaseLayout.astro';
import eventsData from '@/content/calendar.json';
import '@/styles/calendar.css';

const pageTitle = 'bibouroku';

/**
 * FullCalendar の終了日は、その日を含まない exclusive 形式です。
 * calendar.json では実際の最終日を指定できるように、
 * FullCalendar に渡す際に1日追加します。
 */
function addOneDay(dateString: string): string {
  const date = new Date(`${dateString}T00:00:00Z`);
  date.setUTCDate(date.getUTCDate() + 1);

  return date.toISOString().slice(0, 10);
}

const calendarEvents = eventsData.map((event) => ({
  title: event.title,
  start: event.start,
  end: event.end ? addOneDay(event.end) : undefined,
  allDay: true,
  extendedProps: {
    description: event.description
  }
}));
---

<BaseLayout pageTitle={pageTitle}>
  <main class="calendar-container">
    <div
      id="calendar"
      data-events={JSON.stringify(calendarEvents)}
    ></div>

    <aside class="events-sidebar">
      <ul id="event-list"></ul>
    </aside>
  </main>
</BaseLayout>

<script>
  import { Calendar } from '@fullcalendar/core';
  import dayGridPlugin from '@fullcalendar/daygrid';

  document.addEventListener('DOMContentLoaded', () => {
    const calendarEl = document.getElementById('calendar');
    const eventListEl = document.getElementById('event-list');

    if (!calendarEl || !eventListEl) {
      return;
    }

    const events = JSON.parse(calendarEl.dataset.events || '[]');

    let tooltipEl: HTMLElement | null = null;

    const calendar = new Calendar(calendarEl, {
      plugins: [dayGridPlugin],
      initialView: 'dayGridMonth',
      events,
      height: 'auto',

      headerToolbar: {
        left: 'prevYear,prev today',
        center: 'title',
        right: 'next,nextYear'
      },

      // イベントをホバーしたときに詳細を表示する
      eventMouseEnter: (info) => {
        if (tooltipEl) {
          tooltipEl.remove();
        }

        tooltipEl = document.createElement('div');
        tooltipEl.className = 'calendar-tooltip';

        const description = info.event.extendedProps.description;

        const titleEl = document.createElement('div');
        titleEl.className = 'tooltip-title';
        titleEl.textContent = info.event.title;

        tooltipEl.appendChild(titleEl);

        if (description) {
          const descriptionEl = document.createElement('div');
          descriptionEl.className = 'tooltip-desc';
          descriptionEl.innerHTML = description;

          tooltipEl.appendChild(descriptionEl);
        }

        document.body.appendChild(tooltipEl);

        tooltipEl.style.top = `${info.jsEvent.pageY + 15}px`;

        if (window.innerWidth <= 768) {
          tooltipEl.classList.add('tooltip-mobile');
        } else {
          tooltipEl.style.left = `${info.jsEvent.pageX + 15}px`;
        }
      },

      eventMouseLeave: () => {
        if (tooltipEl) {
          tooltipEl.remove();
          tooltipEl = null;
        }
      },

      datesSet: () => {
        updateSidebarEvents();
      }
    });

    calendar.render();

    function updateSidebarEvents() {
      eventListEl.innerHTML = '';

      const calendarEvents = calendar
        .getEvents()
        .filter((event) => event.start !== null);

      const viewDate = calendar.getDate();
      const viewTimestamp = viewDate.getTime();

      calendarEvents.sort((eventA, eventB) => {
        const startA = eventA.start?.getTime() ?? 0;
        const startB = eventB.start?.getTime() ?? 0;

        const differenceA = Math.abs(startA - viewTimestamp);
        const differenceB = Math.abs(startB - viewTimestamp);

        return differenceA - differenceB;
      });

      const nearestEvents = calendarEvents.slice(0, 5);

      nearestEvents.sort((eventA, eventB) => {
        const startA = eventA.start?.getTime() ?? 0;
        const startB = eventB.start?.getTime() ?? 0;

        return startA - startB;
      });

      nearestEvents.forEach((event) => {
        if (!event.start) {
          return;
        }

        const li = document.createElement('li');
        li.className = 'event-item';

        const startDateString = event.start.toLocaleDateString('ja-JP', {
          year: 'numeric',
          month: 'numeric',
          day: 'numeric'
        });

        let dateDisplay = startDateString;

        if (event.end) {
          /*
           * FullCalendar の end は、終了日の翌日を表します。
           * 1ミリ秒引いて、実際の最終日に戻します。
           */
          const actualEndDate = new Date(event.end.getTime() - 1);

          const startDateOnly = new Date(
            event.start.getFullYear(),
            event.start.getMonth(),
            event.start.getDate()
          ).getTime();

          const endDateOnly = new Date(
            actualEndDate.getFullYear(),
            actualEndDate.getMonth(),
            actualEndDate.getDate()
          ).getTime();

          if (startDateOnly !== endDateOnly) {
            const endDateString = actualEndDate.toLocaleDateString('ja-JP', {
              year: 'numeric',
              month: 'numeric',
              day: 'numeric'
            });

            dateDisplay = `${startDateString} - ${endDateString}`;
          }
        }

        const eventHeaderEl = document.createElement('div');
        eventHeaderEl.className = 'event-header';

        const eventDateEl = document.createElement('span');
        eventDateEl.className = 'event-date';
        eventDateEl.textContent = dateDisplay;

        const eventTitleEl = document.createElement('span');
        eventTitleEl.className = 'event-title';
        eventTitleEl.textContent = event.title;

        const eventDescriptionEl = document.createElement('div');
        eventDescriptionEl.className = 'event-desc';
        eventDescriptionEl.innerHTML =
          event.extendedProps.description || '';

        eventHeaderEl.appendChild(eventDateEl);
        eventHeaderEl.appendChild(eventTitleEl);

        li.appendChild(eventHeaderEl);
        li.appendChild(eventDescriptionEl);

        li.addEventListener('click', () => {
          if (event.start) {
            calendar.gotoDate(event.start);
          }
        });

        eventListEl.appendChild(li);
      });
    }
  });
</script>